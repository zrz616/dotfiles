#!/usr/bin/env bash
# IPinfo CLI - 查看 IP 信息

CONFIG_DIR="$HOME/.ipinfo"
TOKEN_FILE="$CONFIG_DIR/token"

# 读取 token
TOKEN=""
if [ -f "$TOKEN_FILE" ]; then
  TOKEN=$(cat "$TOKEN_FILE" | tr -d '\n' | tr -d '[:space:]')
fi

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
  echo "Usage: ipinfo [IP|域名]"
  echo ""
  echo "示例:"
  echo "  ipinfo              # 查看本机 IP"
  echo "  ipinfo 8.8.8.8    # 查看指定 IP"
  echo "  ipinfo google.com  # 查看域名解析的 IP"
  echo ""
  echo "配置文件: ~/.ipinfo/token"
  exit 1
}

# 获取 IP 信息
fetch_ipinfo() {
  local ip="$1"
  
  if [ -z "$TOKEN" ]; then
    curl -s "https://ipinfo.io/$ip/json"
  else
    curl -s -H "Authorization: Bearer $TOKEN" "https://api.ipinfo.io/lite/$ip"
  fi
}

# 格式化输出
format_output() {
  local json="$1"
  
  local ip=$(echo "$json" | yq -r '.ip')
  if [ -z "$ip" ] || [ "$ip" == "null" ]; then
    echo -e "${RED}Error: Unable to fetch IP info${NC}"
    [ -n "$TOKEN" ] && echo "请检查 ~/.ipinfo/token 是否配置正确"
    exit 1
  fi
  
  echo ""
  echo -e "${CYAN}╭─────────────────────────────────${NC}"
  echo -e "${CYAN}│${NC}  ${GREEN}IP Info${NC}                       ${CYAN}│${NC}"
  echo -e "${CYAN}╰─────────────────────────────────${NC}"
  echo ""
  
  echo -e "  ${YELLOW}IP:${NC}         $ip"
  
  # 标准格式字段
  local hostname=$(echo "$json" | yq -r '.hostname // .host // ""')
  [ -n "$hostname" ] && [ "$hostname" != "null" ] && [ "$hostname" != "" ] && echo -e "  ${YELLOW}Hostname:${NC}   $hostname"
  
  # Lite API 格式
  local asn=$(echo "$json" | yq -r '.asn // ""')
  local as_name=$(echo "$json" | yq -r '.as_name // .asn // ""')
  if [ -n "$asn" ] && [ "$asn" != "null" ] && [ "$asn" != "" ]; then
    if [ -n "$as_name" ] && [ "$as_name" != "null" ] && [ "$as_name" != "" ]; then
      echo -e "  ${YELLOW}ASN:${NC}         $asn - $as_name"
    else
      echo -e "  ${YELLOW}ASN:${NC}         $asn"
    fi
  fi
  
  # 标准格式字段
  local org=$(echo "$json" | yq -r '.org // ""')
  [ -n "$org" ] && [ "$org" != "null" ] && [ "$org" != "" ] && echo -e "  ${YELLOW}Org:${NC}        $org"
  
  local city=$(echo "$json" | yq -r '.city // ""')
  local region=$(echo "$json" | yq -r '.region // ""')
  local country=$(echo "$json" | yq -r '.country // .country_code // ""')
  if [ -n "$city" ] && [ "$city" != "null" ] && [ "$city" != "" ]; then
    echo -e "  ${YELLOW}Location:${NC}   $city, $region, $country"
  fi
  
  local country_name=$(echo "$json" | yq -r '.country_name // ""')
  local country_code=$(echo "$json" | yq -r '.country_code // ""')
  if [ -n "$country_name" ] && [ "$country_name" != "null" ] && [ "$country_name" != "" ]; then
    echo -e "  ${YELLOW}Country:${NC}     $country_name ($country_code)"
  elif [ -n "$country" ] && [ "$country" != "null" ] && [ "$country" != "" ]; then
    echo -e "  ${YELLOW}Country:${NC}     $country"
  fi
  
  local continent=$(echo "$json" | yq -r '.continent // ""')
  [ -n "$continent" ] && [ "$continent" != "null" ] && [ "$continent" != "" ] && echo -e "  ${YELLOW}Continent:${NC}   $continent"
  
  local isp=$(echo "$json" | yq -r '.isp // .org // ""')
  [ -n "$isp" ] && [ "$isp" != "null" ] && [ "$isp" != "" ] && echo -e "  ${YELLOW}ISP:${NC}        $isp"
  
  local loc=$(echo "$json" | yq -r '.loc // ""')
  [ -n "$loc" ] && [ "$loc" != "null" ] && [ "$loc" != "" ] && echo -e "  ${YELLOW}Coordinates:${NC} $loc"
  
  local timezone=$(echo "$json" | yq -r '.timezone // ""')
  [ -n "$timezone" ] && [ "$timezone" != "null" ] && [ "$timezone" != "" ] && echo -e "  ${YELLOW}Timezone:${NC}   $timezone"
  
  local postal=$(echo "$json" | yq -r '.postal // ""')
  [ -n "$postal" ] && [ "$postal" != "null" ] && [ "$postal" != "" ] && echo -e "  ${YELLOW}Postal:${NC}      $postal"
  
  local anycast=$(echo "$json" | yq -r '.anycast // ""')
  [ -n "$anycast" ] && [ "$anycast" == "true" ] && echo -e "  ${YELLOW}Anycast:${NC}     Yes"
  
  echo ""
}

# 判断是否为 IP 地址
is_ip() {
  [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# 主函数
main() {
  local target="${1:-}"
  
  if [ "$target" == "-h" ] || [ "$target" == "--help" ]; then
    usage
  fi
  
  local ip=""
  if [ -z "$target" ]; then
    ip=$(curl -s ifconfig.me 2>/dev/null || curl -s icanhazip.com 2>/dev/null || curl -s ipinfo.io/ip 2>/dev/null)
  elif is_ip "$target"; then
    ip="$target"
  else
    ip=$(dig +short "$target" A 2>/dev/null | head -1)
    [ -z "$ip" ] && ip=$(nslookup "$target" 2>/dev/null | grep -A1 "Name:" | tail -1 | awk '{print $NF}')
  fi
  
  if [ -z "$ip" ]; then
    echo -e "${RED}Error: Unable to resolve IP${NC}"
    exit 1
  fi
  
  local json=$(fetch_ipinfo "$ip")
  format_output "$json"
}

main "$@"
