# ===========================================
# 目录操作配置 (Oh My Zsh directories)
# ===========================================

# Zsh 目录选项
setopt auto_cd              # 输入目录名直接进入
setopt auto_pushd           # 自动 pushd
setopt pushd_ignore_dups    # 忽略重复目录
setopt pushd_minus          # 使用 pushd -N

# ===========================================
# 目录快捷命令
# ===========================================

# 快速回到上级目录
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'

# pushd 历史记录
alias -- -='cd -'      # 上一个目录
alias 1='cd -1'        # 第1个目录
alias 2='cd -2'        # 第2个目录
alias 3='cd -3'        # 第3个目录
alias 4='cd -4'        # 第4个目录
alias 5='cd -5'        # 第5个目录
alias 6='cd -6'        # 第6个目录
alias 7='cd -7'        # 第7个目录
alias 8='cd -8'        # 第8个目录
alias 9='cd -9'        # 第9个目录

# 目录创建/删除
alias md='mkdir -p'     # 创建目录
alias rd='rmdir'        # 删除空目录

# ===========================================
# 目录栈 (d 命令)
# ===========================================

# d - 显示目录栈
# 用法: d [n] - 跳转到第 n 个目录
d() {
  if [[ -n $1 ]]; then
    dirs "$@"
  else
    dirs -v | head -n 10
  fi
}

# zsh 自动补全
compdef _dirs d
